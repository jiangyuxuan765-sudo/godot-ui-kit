texture = ExtResource("52_hsbg")
texture_margin_left = 10.0
texture_margin_right = 10.0

; ★分隔线同理，而且它比滑块更彻底：H/VSeparator 的整个控件厚度就是
; separator stylebox 的 min size 短轴，塌成 0 时**一个像素都不画**
; （滑块至少还剩个走 icons 的拖动键）。实测 战术锋线 的 HSeparator
; 画 0/420 列，而用 StyleBoxFlat 的第一到第十套画 1 行 —— 差别就在这。
; 十一/十二/十三/十四套也是 SBTexture + 短轴 0，同样的病。
; 短轴取贴图全高 10。
[sub_resource type="StyleBoxTexture" id="Sep"]
