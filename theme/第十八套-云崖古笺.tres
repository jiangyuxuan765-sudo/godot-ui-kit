[sub_resource type="StyleBoxEmpty" id="Empty"]

; ★滑块/滚动条这六个 stylebox 的 content_margin **短轴必须显式写**。
;
; StyleBoxTexture 的 content_margin 缺省（-1）时是**逐边回退到 texture_margin**
; 的。而这六张图只需要沿长轴做九宫格拉伸，短轴 texture_margin 天然是 0 ——
; 于是 get_minimum_size() 的短轴 = 0+0 = 0。
;
; HSlider / HScrollBar / VScrollBar 正是拿 slider(scroll) stylebox 的
; get_minimum_size() 短轴当**轨道厚度**：它是 0，轨道就被画成 0 像素高，
; 整条槽和填充条一个像素都不出现。而拖动键走 icons/grabber（Texture2D，
; 不经 stylebox），照常画满 34×52 —— 屏幕上就剩一个悬空的青色小键，
; 看起来像「只有按钮没有拖拽条」。「战术交火」注入后就是这个症状，
; 而四层/五层验收全绿：几何层量的是控件矩形（406×52，对的），
; 截图层判非背景像素（面板底本来就亮），谁都碰不到「轨道厚度」这个量。
;
; 短轴取贴图短边全值（22/14/30/24），长轴照抄各自的 texture_margin 保持原样。
; 注意 content_margin 只影响最小尺寸与内容区，不改绘制矩形，所以补它不会挪动外观。
[sub_resource type="StyleBoxTexture" id="HSb_grab"]
content_margin_left = 30.0
content_margin_top = 12.0
content_margin_right = 24.0
content_margin_bottom = 12.0
texture = ExtResource("53_hsgrab")
texture_margin_left = 30.0
texture_margin_right = 24.0

[sub_resource type="StyleBoxTexture" id="HSb_bg"]
